#!/bin/bash

counter=1

while true; do
    echo "[$counter 回目の実行]"

	python genrand2x2.py > tmp
	cat head2 tmp tail2 > ${counter}.in


	exit_code=$?

	# timeout 60 ../otter < ${counter}.in > ${counter}.log 2> /dev/null
	timeout 60 ../otter < ${counter}.in > ${counter}.log 2>&1

	exit_code=$?

	if [ $exit_code -eq 124 ]; then
	    # echo "60秒経過したため強制終了しました。"
	    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 60 seconds passed"
	elif [ $exit_code -ne 0 ]; then
	    echo "[$(date '+%Y-%m-%d %H:%M:%S')] anomaly"
	    # echo "OTTERが異常終了しました（終了コード: $exit_code）"
	else
	    echo "[$(date '+%Y-%m-%d %H:%M:%S')] exited normally"
	    break
	fi

    echo "-----------------------------"
    counter=$((counter + 1))
    sleep 4
done
